# Port d'écoute du serveur backend SENDA
PORT=4000

# Base de données PostgreSQL
DATABASE_URL="postgresql://senda_user:senda_password@localhost:5432/senda_db?schema=public"

# Clé de signature des jetons de session SIWE (JWT)
JWT_SECRET="senda_secret_jwt_key_pour_signature_cryptographique_2026"

# Clés d'accès Pinata pour le stockage décentralisé IPFS (côté serveur uniquement)
PINATA_API_KEY="votre_cle_api_pinata"
PINATA_SECRET_KEY="votre_secret_api_pinata"
PINATA_GATEWAY_URL="https://gateway.pinata.cloud"

# Nœud RPC Polygon Amoy pour la vérification on-chain
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
